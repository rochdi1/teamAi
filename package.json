{
  "name": "ai-commit-gen",
  "displayName": "AI Commit Message Generator",
  "description": "Generiert Commit-Nachrichten aus staged diffs mit lokalem LLM (Ollama / llama.cpp / Docker)",
  "version": "0.2.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiCommitGen.generateCommit",
    "onCommand:aiCommitGen.showBackend",
    "onCommand:aiCommitGen.regenerate",
    "onCommand:aiCommitGen.settings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCommitGen.generateCommit",
        "title": "AI: Generiere Commit-Nachricht",
        "category": "AI Commit"
      },
      {
        "command": "aiCommitGen.regenerate",
        "title": "AI: Commit-Nachricht neu generieren",
        "category": "AI Commit"
      },
      {
        "command": "aiCommitGen.showBackend",
        "title": "AI: Zeige aktives LLM-Backend",
        "category": "AI Commit"
      },
      {
        "command": "aiCommitGen.settings",
        "title": "AI: Einstellungen öffnen",
        "category": "AI Commit"
      }
    ],
    "configuration": {
      "title": "AI Commit Message Generator",
      "properties": {
        "aiCommitGen.backend": {
          "type": "string",
          "enum": ["auto", "ollama-native", "llamacpp-server", "docker-ollama"],
          "default": "auto",
          "description": "LLM-Backend wählen (auto = automatische Detection)"
        },
        "aiCommitGen.model": {
          "type": "string",
          "default": "llama3.1:3b-instruct-q4_K_M",
          "description": "Lokaler Modellname (Ollama/llama.cpp)"
        },
        "aiCommitGen.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Sampling-Temperatur (0 = deterministisch, 1 = kreativ)"
        },
        "aiCommitGen.maxTokens": {
          "type": "number",
          "default": 128,
          "minimum": 16,
          "maximum": 512,
          "description": "Max. Token für die Commit-Nachricht"
        },
        "aiCommitGen.maxDiffChars": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 10000,
          "description": "Max. Zeichen aus dem staged Diff für den Prompt"
        },
        "aiCommitGen.allowDockerBackend": {
          "type": "boolean",
          "default": false,
          "description": "Docker-Backend als Fallback erlauben (Enterprise / Air-Gapped)"
        },
        "aiCommitGen.enablePreview": {
          "type": "boolean",
          "default": true,
          "description": "Vorschau der Commit-Nachricht anzeigen vor dem Commit"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aiCommitGen.generateCommit",
          "when": "resourceScheme == file"
        },
        {
          "command": "aiCommitGen.regenerate",
          "when": "resourceScheme == file"
        },
        {
          "command": "aiCommitGen.showBackend",
          "when": "true"
        },
        {
          "command": "aiCommitGen.settings",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "aiCommitGen.generateCommit",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiCommitGen.generateCommit",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "resourceScheme == file"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.89.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^8.0.0",
    "glob": "^10.4.1",
    "mocha": "^10.4.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.23.0"
  },
  "dependencies": {}
}